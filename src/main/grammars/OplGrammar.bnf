{
  parserClass="com.github.cplexopl.parser.OplParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Opl"
  psiImplClassSuffix="Impl"
  psiPackage="com.github.cplexopl.psi"
  psiImplPackage="com.github.cplexopl.psi.impl"

  elementTypeHolderClass="com.github.cplexopl.psi.OplTypes"
  elementTypeClass="com.github.cplexopl.psi.OplElementType"
  tokenTypeClass="com.github.cplexopl.psi.OplTokenType"

  tokens=[
    // Keywords - reserved words of the OPL language
    USING       = 'using'
    CP          = 'cp'
    INTERVAL    = 'interval'
    SEQUENCE    = 'sequence'
    WITH        = 'with'
    MINIMIZE    = 'minimize'
    MAXIMIZE    = 'maximize'
    SUBJECT     = 'subject'
    FORALL      = 'forall'
    EXISTS      = 'exists'
    KEY         = 'key'
    IN          = 'in'
    TO          = 'to'
    IF          = 'if'
    ELSE        = 'else'
    THEN        = 'then'
    INT         = 'int'
    INT_PLUS    = 'int+'
    FLOAT       = 'float'
    FLOAT_PLUS  = 'float+'
    BOOLEAN     = 'boolean'
    STRING      = 'string'
    RANGE       = 'range'
    TUPLE       = 'tuple'
    DVAR        = 'dvar'
    DEXPR       = 'dexpr'
    EXECUTE     = 'execute'
    MAIN        = 'main'
    INCLUDE     = 'include'
    ASSERT      = 'assert'
    SUM         = 'sum'
    ALL         = 'all'
    PULSE       = 'pulse'
    STEP        = 'step'
    ALLDIFFERENT= 'allDifferent'
    PACK        = 'pack'
    SIZE        = 'size'

    // Operators
    SEMICOLON   = ';'
    COLON       = ':'
    COMMA       = ','
    ELLIPSIS    = '...'
    DOTDOT      = '..'
    DOT         = '.'
    EQ          = '='
    EQEQ        = '=='
    NEQ         = '!='
    IMPLIES     = '=>'
    LT          = '<'
    LE          = '<='
    GT          = '>'
    GE          = '>='
    PLUS        = '+'
    MINUS       = '-'
    STAR        = '*'
    SLASH       = '/'
    ANDAND      = '&&'
    OROR        = '||'
    NOT         = '!'
    MOD         = '%'
    QUESTION    = '?'
    LBRACE      = '{'
    RBRACE      = '}'
    LBRACKET    = '['
    RBRACKET    = ']'
    LPAREN      = '('
    RPAREN      = ')'

    // Token types with regular expressions (regex)
    // Regex is a pattern describing text format, e.g. [0-9]+ = one or more digits
    LINE_COMMENT  = 'regexp://[^\r\n]*'
    BLOCK_COMMENT = 'regexp:/\*([^*]|\*(?!/))*\*/'
    STRING_LITERAL = 'regexp:"([^"\\]|\\.)*"'
    INTEGER_LITERAL = 'regexp:-?[0-9]+'
    FLOAT_LITERAL   = 'regexp:-?[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?'
    ID              = 'regexp:[a-zA-Z_][a-zA-Z0-9_]*'
  ]
}

// Root rule: an OPL file is a sequence of declarations
oplFile ::= item_*
private item_ ::= declaration | SEMICOLON

// Declaration can be of various types
declaration ::= varDeclaration
              | dvarDeclaration
              | dexprDeclaration
              | objectiveDeclaration
              | constraintSection
              | executeBlock
              | tupleDeclaration
              | includeDeclaration
              | usingDeclaration
              | assertDeclaration

// Generalized types (basic, tuples, or sets of them)
private baseType ::= (INT | FLOAT) PLUS? | INT_PLUS | FLOAT_PLUS | BOOLEAN | STRING | RANGE
private typeRef ::= baseType | ID | LBRACE (baseType | ID) RBRACE

// Top-level assert declaration
assertDeclaration ::= ASSERT expression SEMICOLON { pin=1 recoverWhile=statement_recover }

// Data variable declaration (supports arrays, ellipses, and ranges)
varDeclaration ::= typeRef ID (LBRACKET expression RBRACKET)* (EQ (ELLIPSIS | expression))? SEMICOLON { 
  pin=2 
  recoverWhile=statement_recover 
  implements="com.github.cplexopl.psi.OplNamedElement"
  mixin="com.github.cplexopl.psi.OplNamedElementImpl"
}

// Using declaration (enables CP engine)
usingDeclaration ::= USING CP SEMICOLON { pin=1 recoverWhile=statement_recover }

// Decision variable declaration (supports arrays, intervals, sequences, sign restrictions and CP clauses)
dvarDeclaration ::= DVAR ((INT | FLOAT) PLUS? | INT_PLUS | FLOAT_PLUS | BOOLEAN | INTERVAL | SEQUENCE) ID (LBRACKET (oplIterator | expression) RBRACKET)* ( (IN ALL | IN | SIZE | ID) (LPAREN oplIterator (COMMA oplIterator)* RPAREN)? expression )* SEMICOLON { 
  pin=1 
  recoverWhile=statement_recover 
  implements="com.github.cplexopl.psi.OplNamedElement"
  mixin="com.github.cplexopl.psi.OplNamedElementImpl"
}

// Decision expression declaration (named formulas evaluated by solver)
dexprDeclaration ::= DEXPR typeRef ID (LBRACKET (oplIterator | expression) RBRACKET)* EQ expression SEMICOLON {
  pin=1
  recoverWhile=statement_recover
  implements="com.github.cplexopl.psi.OplNamedElement"
  mixin="com.github.cplexopl.psi.OplNamedElementImpl"
}

// Objective function - what we minimize/maximize
objectiveDeclaration ::= (MINIMIZE | MAXIMIZE) expression SEMICOLON { pin=1 recoverWhile=statement_recover }

// Constraint section
constraintSection ::= SUBJECT TO LBRACE constraintItem* RBRACE { pin=1 }

// Iterator definition for loops and sums (e.g. i in 1..9 : x != 0)
oplIterator ::= ID (COMMA ID)* IN expression (COLON expression)?

// Conflict guard: optional label (private to avoid breaking Annotator)
private label ::= ID COLON

constraintItem ::= label? expression SEMICOLON
                 | label? FORALL LPAREN oplIterator (COMMA oplIterator)* RPAREN LBRACE constraintItem* RBRACE
                 | label? FORALL LPAREN oplIterator (COMMA oplIterator)* RPAREN constraintItem

// Execute block - IBM Script code (JavaScript-like)
executeBlock ::= (EXECUTE | MAIN) ID? executeBody { pin=1 recoverWhile=statement_recover }
executeBody ::= LBRACE executeItem* RBRACE
private executeItem ::= executeBody | executeToken
private executeToken ::= ID | INTEGER_LITERAL | FLOAT_LITERAL | STRING_LITERAL | LPAREN | RPAREN | LBRACKET | RBRACKET | PLUS | MINUS | STAR | SLASH | EQ | EQEQ | NEQ | LT | LE | GT | GE | SEMICOLON | COMMA | DOT | DOTDOT | ELLIPSIS | COLON | QUESTION | INT | FLOAT | BOOLEAN | STRING | RANGE | DVAR | DEXPR | TUPLE | MINIMIZE | MAXIMIZE | SUBJECT | TO | INCLUDE | EXECUTE | MAIN | FORALL | EXISTS | IN | IF | ELSE | THEN | USING | CP | INTERVAL | SEQUENCE | WITH | ASSERT | SUM | ALL | PULSE | STEP | ALLDIFFERENT | PACK | SIZE | ANDAND | OROR | NOT | MOD

// Tuple declaration (struct-like type)
tupleDeclaration ::= TUPLE ID LBRACE tupleField* RBRACE SEMICOLON? { 
  pin=1 
  recoverWhile=statement_recover 
  implements="com.github.cplexopl.psi.OplNamedElement"
  mixin="com.github.cplexopl.psi.OplNamedElementImpl"
}
tupleField ::= typeRef ID (LBRACKET expression RBRACKET)* SEMICOLON { pin=2 }

// Include another file
includeDeclaration ::= INCLUDE STRING_LITERAL SEMICOLON { pin=1 }

// Expressions (simplified)
expression ::= logicalOrExpression
private logicalOrExpression ::= logicalAndExpression (OROR logicalAndExpression)*
private logicalAndExpression ::= ternaryExpression (ANDAND ternaryExpression)*
private ternaryExpression ::= relationalExpression (QUESTION expression COLON expression)?
private relationalExpression ::= rangeExpression ((LE | LT | GT | GE | EQ | EQEQ | NEQ | IN) rangeExpression)*
private rangeExpression ::= additiveExpression (DOTDOT additiveExpression)?
private additiveExpression ::= term ((PLUS | MINUS) term)*
term ::= factor ((STAR | SLASH) factor)*

// Extended factor: supports sums, all loops, CP functions, arrays, numbers and variables
factor ::= (PLUS | MINUS) factor
         | (SUM | ALL | MINIMIZE | MAXIMIZE | ID) LPAREN oplIterator (COMMA oplIterator)* RPAREN expression
         | (ID | ALLDIFFERENT | PACK | PULSE | STEP) ( LPAREN (expression (COMMA expression)*)? RPAREN )? ( (DOT ID) | (LBRACKET expression RBRACKET) )*
         | INTEGER_LITERAL
         | FLOAT_LITERAL
         | STRING_LITERAL
         | LBRACKET (expression (COMMA expression)*)? RBRACKET
         | LPAREN expression RPAREN

// Recovery rule: "Skip everything until a new declaration start or semicolon"
private statement_recover ::= !(INT | FLOAT | BOOLEAN | INTERVAL | SEQUENCE | STRING | RANGE | DVAR | DEXPR | TUPLE | MINIMIZE | MAXIMIZE | SUBJECT | INCLUDE | EXECUTE | MAIN | USING | LBRACE | ID | SEMICOLON | RBRACE | ASSERT)
